# ─── DATABASE & SERVER ─────────────────────────────────────────────────────────
PORT=8000
NODE_ENV="development"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/career_connect?retryWrites=true&w=majority"
SECRET_KEY="your-jwt-secret-key-change-in-production"
FRONTEND_URL="http://localhost:5173"

# ─── CLOUDINARY (Media Storage) ───────────────────────────────────────────────
CLOUDINARY_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_SECRET_KEY="your-api-secret"

# ─── EMAIL NOTIFICATIONS (Nodemailer SMTP) ────────────────────────────────────
# Configure your SMTP credentials below to enable live email delivery.
# If left unconfigured, the system runs in safe development simulation mode,
# logging simulated email events without interrupting or failing requests.

# Example 1: Gmail SMTP (Use a Google App Password, not your regular password)
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER="your-email@gmail.com"
# EMAIL_PASS="your-16-digit-app-password"
# EMAIL_FROM='"Career Connect" <your-email@gmail.com>'

# Example 2: Mailtrap (Safe local development testing)
# EMAIL_HOST="sandbox.smtp.mailtrap.io"
# EMAIL_PORT=2525
# EMAIL_SECURE=false
# EMAIL_USER="your-mailtrap-username"
# EMAIL_PASS="your-mailtrap-password"
# EMAIL_FROM='"Career Connect" <notifications@careerconnect.com>'

# Example 3: Production SMTP (SendGrid, AWS SES, Postmark, Resend, etc.)
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM='"Career Connect" <no-reply@careerconnect.com>'
